    "/v1/conversations/{conversation_id}/messages": {
      "post": {
        "description": "Ask a question. With `Accept: text/event-stream` the answer streams as events: `message` (its id),\n`step` as each step finishes, `table`, `chart`, `token` (summary text: add it, or with `replace` use it\ninstead of everything so far), and `done` with the whole message; or `error` with a problem object.\nOtherwise the response is the finished message as JSON.",
        "operationId": "ask_v1_conversations__conversation_id__messages_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskV1"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageV1"
                }
              },
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask",
        "tags": [
          "v1"
        ]
      }
    },
    "/v1/messages/{message_id}": {
      "get": {
        "operationId": "get_message_v1_messages__message_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "message_id",
            "required": true,
