{
  "components": {
    "schemas": {
      "Answer": {
        "description": "Everything the analyst returns for one question. New fields are only ever added, each with a default.",
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Plain-text reply for schema and out-of-scope questions.",
            "title": "Answer"
          },
          "assumptions": {
            "description": "How an ambiguous question was read, in plain words.",
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "attempts": {
            "default": 0,
            "title": "Attempts",
            "type": "integer"
          },
          "cached": {
            "default": false,
            "description": "Served from the answer cache, without running the pipeline.",
            "title": "Cached",
            "type": "boolean"
          },
          "chart": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChartSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "chart_source": {
            "anyOf": [
              {
                "enum": [
                  "llm",
                  "fallback"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chart Source"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "title": "Columns",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when no working query could be built.",
            "title": "Error"
          },
          "failures": {
            "items": {
              "$ref": "#/components/schemas/Failure"
            },
            "title": "Failures",
            "type": "array"
          },
          "intent": {
            "anyOf": [
              {
                "enum": [
                  "data_query",
                  "schema_question",
                  "out_of_scope"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "llm_calls": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Llm Calls",
            "type": "array"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "rows": {
            "items": {
              "items": {},
              "type": "array"
            },
            "title": "Rows",
            "type": "array"
          },
          "sql": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sql"
          },
          "sql_reasoning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sql Reasoning"
          },
          "standalone_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A follow-up question as it was understood with the earlier ones in its conversation.",
            "title": "Standalone Question"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "summary_verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether every figure in the summary was found in the result (None: not checked).",
            "title": "Summary Verified"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          },
          "truncated": {
            "default": false,
            "title": "Truncated",
            "type": "boolean"
          },
          "verified_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Answered with the verified query for this question instead of writing new SQL.",
            "title": "Verified Question"
          }
        },
        "required": [
          "question",
          "intent",
          "answer",
          "sql",
          "sql_reasoning",
          "columns",
          "rows",
          "truncated",
          "chart",
          "chart_source",
          "summary",
          "error",
          "attempts",
          "failures",
          "timings",
          "llm_calls",
          "cached",
          "verified_question",
          "assumptions",
          "summary_verified",
          "standalone_question"
        ],
        "title": "Answer",
        "type": "object"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskV1": {
        "properties": {
          "dataset_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ask about an uploaded file (POST /v1/datasets) instead of the demo's sales data.",
            "title": "Dataset Id"
          },
          "question": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskV1",
        "type": "object"
      },
      "Body_transcribe_v1_transcribe_post": {
        "properties": {
          "audio": {
            "contentMediaType": "application/octet-stream",
            "title": "Audio",
            "type": "string"
          },
          "language": {
            "anyOf": [
              {
                "maxLength": 8,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          }
        },
        "required": [
          "audio"
        ],
        "title": "Body_transcribe_v1_transcribe_post",
        "type": "object"
      },
      "Body_upload_v1_datasets_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_datasets_post",
        "type": "object"
      },
      "ChartSpec": {
        "properties": {
          "series": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional categorical column that splits lines/bars.",
            "title": "Series"
          },
          "title": {
            "description": "Short chart title in plain English.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "enum": [
              "bar",
              "line",
              "pie",
              "scatter",
              "kpi",
              "table"
            ],
            "title": "Type",
            "type": "string"
          },
          "x": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Column for the x axis or pie labels; null for kpi/table.",
            "title": "X"
          },
          "y": {
            "description": "Numeric measure column(s).",
            "items": {
              "type": "string"
            },
            "title": "Y",
            "type": "array"
          }
        },
        "required": [
          "type",
          "x",
          "y",
          "series",
          "title"
        ],
        "title": "ChartSpec",
        "type": "object"
      },
      "ColumnV1": {
        "description": "One column of an uploaded table.",
        "properties": {
          "distinct": {
            "description": "Distinct values (approximate on large tables).",
            "title": "Distinct",
            "type": "integer"
          },
          "empty": {
            "description": "Rows with no value.",
            "title": "Empty",
            "type": "integer"
          },
          "examples": {
            "description": "Common values, for text.",
            "items": {
              "type": "string"
            },
            "title": "Examples",
            "type": "array"
          },
          "header": {
            "description": "Its heading in the file.",
            "title": "Header",
            "type": "string"
          },
          "high": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest value, for numbers and dates.",
            "title": "High"
          },
          "kind": {
            "enum": [
              "text",
              "number",
              "date",
              "datetime",
              "yes/no",
              "other"
            ],
            "title": "Kind",
            "type": "string"
          },
          "low": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Smallest value, for numbers and dates.",
            "title": "Low"
          },
          "name": {
            "description": "The column's name in questions and SQL.",
            "title": "Name",
            "type": "string"
          },
          "personal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it is hidden from answers, when it is personal data.",
            "title": "Personal"
          }
        },
        "required": [
          "name",
          "header",
          "kind",
          "empty",
          "distinct",
          "low",
          "high",
          "examples",
          "personal"
        ],
        "title": "ColumnV1",
        "type": "object"
      },
      "ConfigV1": {
        "properties": {
          "features": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Features",
            "type": "object"
          },
          "starters": {
            "items": {
              "type": "string"
            },
            "title": "Starters",
            "type": "array"
          },
          "turnstile_site_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnstile Site Key"
          }
        },
        "required": [
          "turnstile_site_key",
          "starters",
          "features"
        ],
        "title": "ConfigV1",
        "type": "object"
      },
      "ConversationV1": {
        "description": "A conversation in someone's history.",
        "properties": {
          "dataset_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The uploaded dataset it is about; none for the demo data.",
            "title": "Dataset Id"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "title": "Messages",
            "type": "integer"
          },
          "title": {
            "description": "Its first question.",
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "dataset_id",
          "messages",
          "updated_at"
        ],
        "title": "ConversationV1",
        "type": "object"
      },
      "DatasetV1": {
        "description": "An uploaded file, ready for questions.",
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ColumnV1"
            },
            "title": "Columns",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rows": {
            "title": "Rows",
            "type": "integer"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "title": "Suggestions",
            "type": "array"
          },
          "table": {
            "title": "Table",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "table",
          "rows",
          "columns",
          "suggestions",
          "created_at",
          "expires_at"
        ],
        "title": "DatasetV1",
        "type": "object"
      },
      "ExplanationV1": {
        "properties": {
          "steps": {
            "items": {
              "type": "string"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "steps"
        ],
        "title": "ExplanationV1",
        "type": "object"
      },
      "Failure": {
        "description": "An attempt that failed validation or execution, or found nothing, and was fed back to the SQL agent.",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "sql": {
            "title": "Sql",
            "type": "string"
          },
          "stage": {
            "enum": [
              "validate",
              "execute",
              "result"
            ],
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "sql",
          "error",
          "stage"
        ],
        "title": "Failure",
        "type": "object"
      },
      "FeedbackV1": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "enum": [
                  "wrong_data",
                  "misunderstood",
                  "wrong_chart",
                  "lost_context",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "comment": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "rating": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating",
            "type": "string"
          }
        },
        "required": [
          "rating"
        ],
        "title": "FeedbackV1",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeV1": {
        "properties": {
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserV1"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user"
        ],
        "title": "MeV1",
        "type": "object"
      },
      "MessageV1": {
        "description": "One question in a conversation and its answer.",
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "dataset_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The uploaded dataset it asked about; none for the demo data.",
            "title": "Dataset Id"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "suggestions": {
            "description": "Follow-up questions worth asking next.",
            "items": {
              "type": "string"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "dataset_id",
          "question",
          "answer",
          "suggestions",
          "created_at"
        ],
        "title": "MessageV1",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "turnstile_token": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnstile Token"
          }
        },
        "title": "SessionRequest",
        "type": "object"
      },
      "TranscriptV1": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TranscriptV1",
        "type": "object"
      },
      "UserV1": {
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "login",
          "name",
          "avatar_url"
        ],
        "title": "UserV1",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "NL Business Analytics Agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/ask": {
      "post": {
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask"
      }
    },
    "/api/ask/stream": {
      "post": {
        "operationId": "ask_stream_api_ask_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask Stream"
      }
    },
    "/api/config": {
      "get": {
        "description": "Settings the web app needs at runtime.",
        "operationId": "config_api_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config"
      }
    },
    "/api/examples": {
      "get": {
        "operationId": "examples_api_examples_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Examples"
      }
    },
    "/api/health": {
      "get": {
        "description": "Readiness: the database answers.",
        "operationId": "readyz_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz"
      }
    },
    "/api/providers": {
      "get": {
        "description": "Configured model providers in fallback order, and which are cooling down. Never returns keys.",
        "operationId": "providers_api_providers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Providers"
      }
    },
    "/api/schema": {
      "get": {
        "operationId": "schema_api_schema_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Schema"
      }
    },
    "/api/session": {
      "post": {
        "description": "Issue a visitor session cookie, after the Turnstile bot check when it is on.",
        "operationId": "start_session_api_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Session"
      }
    },
    "/healthz": {
      "get": {
