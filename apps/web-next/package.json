{
  "name": "nl-analytics-agent-web-next",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "npm --prefix tools ci --no-audit --no-fund && tools/node_modules/.bin/openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "playwright-core": "1.64.0"
  }
}
