# Copy to .env. Add a key for as many providers as you like; missing ones are skipped.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analytics

# Fallback order: the first provider that has a key and responds answers.
# If it is rate limited, down, slow or returns junk, the next one is tried.
LLM_PROVIDERS=gemini,groq,openrouter,mistral,cloudflare
LLM_TIMEOUT_S=30

GEMINI_API_KEY=          # https://aistudio.google.com/
GROQ_API_KEY=            # https://console.groq.com/
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
MISTRAL_API_KEY=         # https://console.mistral.ai/
CLOUDFLARE_API_TOKEN=    # https://dash.cloudflare.com/ (Workers AI token)
CLOUDFLARE_ACCOUNT_ID=

# Optional: override any provider's model, e.g.
# GROQ_MODEL=qwen/qwen3.6-27b
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: a cheaper, higher-quota model for routing and chart choice (SQL and summaries keep the main model).
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GEMINI_FAST_MODEL=gemini-flash-lite-latest

# Safety limits (defaults shown). See SECURITY.md.
# MAX_QUERY_COST=1000000                     # planner cost above which a query is sent back instead of run
# PERSONAL_DATA_COLUMNS=["customers.email"]  # never returned; usable in filters and COUNT

# Usage limits (defaults shown). See SECURITY.md.
# APP_DATABASE_URL=                          # the app's own tables; defaults to DATABASE_URL
# SESSION_SECRET=                            # signs visitor sessions; set a long random value in production
# TURNSTILE_SITE_KEY= / TURNSTILE_SECRET_KEY= # Cloudflare Turnstile bot check, off unless both are set
# PROXY_SECRET=                              # shared with the web app's Cloudflare Pages proxy, so the API trusts the visitor IP it passes on
# CLIENT_IP_HEADER=                          # e.g. true-client-ip on Render
# QUOTA_SESSION_PER_HOUR=30
# QUOTA_IP_PER_DAY=300
# QUOTA_USER_PER_HOUR=60                     # signed-in users: per hour and per day, and no IP limit
# QUOTA_USER_PER_DAY=500

# Sign in with GitHub (optional; off unless both keys are set). See DEPLOY.md.
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=
# PUBLIC_URL=                                # where visitors open the web app, e.g. https://<project>.pages.dev
# USER_SESSION_DAYS=30
# USER_MESSAGE_RETENTION_DAYS=90             # a signed-in user's history; anonymous messages keep MESSAGE_RETENTION_DAYS
# LLM_DAILY_BUDGET={"groq": 900}             # model calls per provider per UTC day
# ANSWER_CACHE_TTL_S=86400                   # 0 turns the answer cache off

# Context and checks: off by default; turn one on only if `python eval/run_eval.py --split test` holds up with it.
# CONTEXT_RETRIEVAL=true                      # verified examples and named data values in the SQL prompt
# VERIFIED_FAST_PATH=true                     # answer with a verified query outright (needs CONTEXT_RETRIEVAL)
# CHECK_RESULTS=true                          # retry once when a query finds nothing
# CHECK_SUMMARIES=true                        # rewrite once when a summary quotes figures not in the result
# EMBEDDING_MODEL=@cf/baai/bge-m3             # Cloudflare Workers AI, uses the CLOUDFLARE_* keys

# /v1 (defaults shown)
# MESSAGE_RETENTION_DAYS=7                    # questions and answers kept for retries, ratings and explanations
# TRANSCRIBE_MODEL=whisper-large-v3-turbo     # voice questions via Groq (needs GROQ_API_KEY); empty turns voice off
