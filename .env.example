# Copy to .env and fill in one LLM key.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analytics

# Default: Gemini 2.5 Flash (free tier at https://aistudio.google.com/apikey)
LLM_MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=

# Or Claude:
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Or OpenAI:
# LLM_MODEL=openai:gpt-4.1-mini
# OPENAI_API_KEY=
