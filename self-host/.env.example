# Settings for the self-hosted Sales analyst (docker compose reads this file). See docs/self-host.md.

# At least one model provider key. Gemini and Groq both have free tiers.
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY= / MISTRAL_API_KEY= / CLOUDFLARE_API_TOKEN= + CLOUDFLARE_ACCOUNT_ID=

# Signs session cookies. Make one with: openssl rand -hex 32
SESSION_SECRET=

# Which image to run; pin a version (e.g. 2.3.0) to upgrade only when you choose.
# VERSION=latest
# POSTGRES_PASSWORD=analyst
# PORT=8000

# --- Your own data, instead of the sample sales data -----------------------------------------------------------
# A connection as a role that can only SELECT (docs/self-host.md shows how to make one). Tables in its public schema
# are what questions can use.
# DATABASE_URL=postgresql://analytics_reader:secret@db.example.com:5432/shop
# SAMPLE_DATA=false
# REQUIRE_READ_ONLY_DATA=true
# PERSONAL_DATA_COLUMNS=["customers.email","customers.phone"]
# Your own business rules and verified queries (mount the folder in compose.yml too):
# SEMANTIC_DIR=/semantic
